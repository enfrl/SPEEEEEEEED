with(InGameManager){
    switch (num) {
    	case 0:
            global.current_state = STATE.FIRST;
        break;
        
        case 1:
            global.current_state = STATE.SECOND;
        break;
        
        case 2:
            global.current_state = STATE.THIRD;
        break;
        
        case 3:
            global.current_state = STATE.FOURTH;
        break;
        
        case 4:
            global.current_state = STATE.FIFTH;
        break;
        
        case 5:
            global.current_state = STATE.SIXTH;
        break;
        
        case 6:
            global.current_state = STATE.SEVENTH;
        break;
        
        case 7:
            global.current_state = STATE.EIGHTH;
        break;
        
        case 8:
            global.current_state = STATE.NINETH;
        break;
        
        case 9:
            global.current_state = STATE.TENTH;
        break;
        
        case 10:
            global.current_state = STATE.ELEVENTH;
        break;
        
        case 11:
            global.current_state = STATE.TWELVETH;
        break;
    }
}